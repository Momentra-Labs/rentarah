# Local development (`npm run dev` — Vite mode: development)
# See `.env.staging.example` / `.env.production.example` for other modes.

VITE_APP_ENV=development

# Stripe test publishable key — https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_KEY=pk_test_your_publishable_key_here

# Backend base URL — include `/api` (no trailing slash). Required when VITE_USE_MOCK=false
# Example: http://localhost:5000/api  → client path /vehicles hits http://localhost:5000/api/vehicles
VITE_API_URL=http://localhost:5000/api

# Use mockApi.ts when true; set false to call VITE_API_URL
VITE_USE_MOCK=true

# Local credential / mock Google auth (btoa). Defaults to on in `npm run dev`, off in production builds.
# Set true only for demos; never enable in public production.
VITE_ALLOW_LOCAL_AUTH=true

# Firebase (client) — from Firebase Console → Project settings → Your apps → SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rentarah.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rentarah
VITE_FIREBASE_STORAGE_BUCKET=rentarah.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# GitHub Pages project site only: VITE_BASE=/repo-name/
VITE_BASE=/

# Govt ID onboarding — true = auto-approve after upload (demos). Production builds default to false when unset.
VITE_ID_VERIFICATION_INSTANT_APPROVE=true
